{
  "servers": [
    {
      "host": "localhost",
      "ports": [8082, 8081],
      "serverName": "primary-server",
      "isDefault": true,
      "clientMaxBodySize": 10485760,
      "errorPages": {
        "400": "error_pages/400.html",
        "403": "error_pages/403.html",
        "404": "error_pages/404.html",
        "405": "error_pages/405.html",
        "413": "error_pages/413.html",
        "500": "error_pages/500.html"
      },
      "routes": [
        {
          "path": "/",
          "methods": ["GET", "POST"],
          "root": "www/html",
          "index": "index.html",
          "autoindex": false
        },
        {
          "path": "/uploads",
          "methods": ["GET", "POST", "DELETE"],
          "root": "www/uploads",
          "index": "upload.html",
          "autoindex": true,
          "uploadEnabled": true
        },
        {
          "path": "/api",
          "methods": ["GET", "POST"],
          "root": "www/cgi-bin",
          "cgi": {
            ".py": "/usr/bin/python3",
            ".php": "/usr/bin/php"
          }
        },
        {
          "path": "/redirect",
          "redirect": {
            "code": 301,
            "url": "http://localhost:8080/"
          }
        },
        {
          "path": "/static",
          "methods": ["GET"],
          "root": "www/static",
          "autoindex": true
        }
      ],
      "timeout": 30000
    },
    {
      "host": "localhost",
      "ports": [9090],
      "serverName": "secondary-server",
      "isDefault": false,
      "clientMaxBodySize": 5242880,
      "errorPages": {
        "404": "error_pages/custom_404.html"
      },
      "routes": [
        {
          "path": "/",
          "methods": ["GET"],
          "root": "www/secondary",
          "index": "home.html",
          "autoindex": false
        }
      ],
      "timeout": 60000
    }
  ],
  "global": {
    "maxConnections": 1024,
    "bufferSize": 8192,
    "sessionTimeout": 1800000,
    "logLevel": "INFO"
  }
}